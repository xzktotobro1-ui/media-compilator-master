{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-spawn",
    "shell:allow-execute",
    "shell:allow-kill",
    "dialog:default",
    "fs:default",
    "notification:default",
    "core:window:allow-set-progress-bar",
    "core:window:allow-start-dragging"
  ]
}