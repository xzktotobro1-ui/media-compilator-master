<Window x:Class="RTXMediaMaster.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RTXMediaMaster.Gui.ViewModels"
        xmlns:views="clr-namespace:RTXMediaMaster.Gui.Views"
        xmlns:conv="clr-namespace:RTXMediaMaster.Gui.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RTX Media Master"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        MinWidth="1100" MinHeight="700"
        Background="{StaticResource WindowBackgroundBrush}"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
         Style="{StaticResource StudioWindow}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:ItemStatusToBrushConverter x:Key="StatusToBrush" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:StepActiveConverter x:Key="StepActive" />
        <DataTemplate DataType="{x:Type vm:QueueViewModel}">
            <views:QueueView DataContext="{Binding}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
            <views:DiagnosticsView DataContext="{Binding}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView DataContext="{Binding}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogViewModel}">
            <views:LogView DataContext="{Binding}" />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= CUSTOM TITLE BAR ================= -->
        <Border Grid.Row="0" Background="Transparent"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="14,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Логотип + название + неоновый бейдж версии -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/app_icon.ico" Width="18" Height="18"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="RTX Media Master" Style="{StaticResource H3}" />
                    <Border Background="{StaticResource AccentGradientBrush}" CornerRadius="6"
                            Padding="6,2">
                        <TextBlock Text="v3.5" FontSize="11" Foreground="#0B0D10"
                                   FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <!-- Живая капсула GPU справа -->
                <TextBlock Grid.Column="1" Text="{Binding GpuLabel}"
                           Style="{StaticResource BodyMuted}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" />

                <!-- Капсула управления окном -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="─" Style="{StaticResource WinButton}"
                            Click="Minimize_Click" ToolTip="Свернуть" />
                    <Button Content="□" Style="{StaticResource WinButton}"
                            Click="Maximize_Click" ToolTip="Развернуть" />
                    <Button Content="✕" Style="{StaticResource WinButton.Close}"
                            Click="Close_Click" ToolTip="Закрыть" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= ТЕЛО ОКНА ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Левое меню (сайдбар) -->
            <Border Grid.Column="0" Background="#0E1116"
                    BorderThickness="0,0,1,0" BorderBrush="#1A1F26">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,26,0,20">
                        <Button Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:AppPage.Queue}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" Margin="0,0,10,0" />
                                <TextBlock Text="Очередь" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:AppPage.Diagnostics}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" Margin="0,0,10,0" />
                                <TextBlock Text="Диагностика" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:AppPage.Settings}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" Margin="0,0,10,0" />
                                <TextBlock Text="Настройки" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:AppPage.Log}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71E;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" Margin="0,0,10,0" />
                                <TextBlock Text="Журнал" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,26">
                        <Separator Margin="16,8" />
                        <Button Content="Справка" Style="{StaticResource NavButton}"
                                Command="{Binding OpenHelpCommand}" />
                        <Button Content="О программе" Style="{StaticResource NavButton}"
                                Command="{Binding OpenAboutCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Страницы -->
            <Border Grid.Column="1" Background="{StaticResource WindowBackgroundBrush}">
                <ContentControl x:Name="PageHost" Content="{Binding SelectedPageViewModel}" />
            </Border>
        </Grid>

        <!-- ================= СТАТУС-БАР (степпер этапов) ================= -->
        <Border Grid.Row="2" Background="#0E1116"
                BorderThickness="0,1,0,0" BorderBrush="#1A1F26" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Степпер этапов -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Анализ" Style="{StaticResource StepLabel}"
                               Foreground="{Binding ActiveStepIndex, Converter={StaticResource StepActive}, ConverterParameter=0}" />
                    <TextBlock Text=" →" Style="{StaticResource StepArrow}" />
                    <TextBlock Text="Сцены" Style="{StaticResource StepLabel}"
                               Foreground="{Binding ActiveStepIndex, Converter={StaticResource StepActive}, ConverterParameter=1}" />
                    <TextBlock Text=" →" Style="{StaticResource StepArrow}" />
                    <TextBlock Text="RIFE AI" Style="{StaticResource StepLabel}"
                               Foreground="{Binding ActiveStepIndex, Converter={StaticResource StepActive}, ConverterParameter=2}" />
                    <TextBlock Text=" →" Style="{StaticResource StepArrow}" />
                    <TextBlock Text="Кодирование" Style="{StaticResource StepLabel}"
                               Foreground="{Binding ActiveStepIndex, Converter={StaticResource StepActive}, ConverterParameter=3}" />
                    <TextBlock Text=" →" Style="{StaticResource StepArrow}" />
                    <TextBlock Text="Готово" Style="{StaticResource StepLabel}"
                               Foreground="{Binding ActiveStepIndex, Converter={StaticResource StepActive}, ConverterParameter=4}" />
                </StackPanel>

                <!-- Прогресс -->
                <ProgressBar Grid.Column="1" Style="{StaticResource GlassProgressBar}"
                             Value="{Binding GlobalProgress}" Margin="20,0,20,0"
                             VerticalAlignment="Center" Height="6" />
                <TextBlock Grid.Column="1" Text="{Binding GlobalProgressText}"
                           Style="{StaticResource Caption}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" />

                <TextBlock Grid.Column="2" Text="{Binding StatusText}"
                           Style="{StaticResource BodyMuted}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
