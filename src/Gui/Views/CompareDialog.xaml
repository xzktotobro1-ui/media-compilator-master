<Window x:Class="RTXMediaMaster.Gui.Views.CompareDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="До / После" WindowStartupLocation="CenterOwner"
        Width="980" Height="560" Background="{StaticResource WindowBackgroundBrush}"
        WindowStyle="None" ResizeMode="CanResize">
    <Border Style="{StaticResource GlassCardBorder}" CornerRadius="14">
        <Border Style="{StaticResource GlassCard}" CornerRadius="14" Padding="18" Margin="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="До / После — тестовый фрагмент 5 сек"
                           Style="{StaticResource H3}" Margin="0,0,0,12" />

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource GlassCardBorder}" Margin="0,0,8,0">
                        <Border Style="{StaticResource GlassCard}" Padding="10" Margin="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="ДО (оригинал)" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                                <MediaElement x:Name="BeforePlayer" Grid.Row="1" Stretch="Uniform"
                                              LoadedBehavior="Manual" UnloadedBehavior="Stop" />
                            </Grid>
                        </Border>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource GlassCardBorder}" Margin="8,0,0,0">
                        <Border Style="{StaticResource GlassCard}" Padding="10" Margin="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="ПОСЛЕ (RIFE + кодер)" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                                <MediaElement x:Name="AfterPlayer" Grid.Row="1" Stretch="Uniform"
                                              LoadedBehavior="Manual" UnloadedBehavior="Stop" />
                            </Grid>
                        </Border>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <Button Content="Воспроизвести" Style="{StaticResource SecondaryButton}"
                            Click="Play_Click" Width="140" />
                    <Button Content="Закрыть" Style="{StaticResource PrimaryButton}"
                            Click="Close_Click" Margin="12,0,0,0" Width="120" />
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
