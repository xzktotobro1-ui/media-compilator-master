<UserControl x:Class="RTXMediaMaster.Gui.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RTXMediaMaster.Gui.ViewModels"
             xmlns:conv="clr-namespace:RTXMediaMaster.Gui.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="B2V" />
        <conv:NullToVisibilityConverter x:Key="N2V" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12,16,16">
        <StackPanel>

            <!-- ================= ОФОРМЛЕНИЕ ================= -->
            <Border Style="{StaticResource GlassCardBorder}" Margin="0,0,0,12">
                <Border Style="{StaticResource GlassCard}" Padding="18,16" Margin="1">
                    <StackPanel>
                        <TextBlock Text="Тема оформления" Style="{StaticResource H3}" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Тёмная" Style="{StaticResource PillSegment}" GroupName="Theme"
                                         IsChecked="{Binding IsThemeDark, Mode=TwoWay}" />
                            <RadioButton Content="Светлая" Style="{StaticResource PillSegment}" GroupName="Theme"
                                         IsChecked="{Binding IsThemeLight, Mode=TwoWay}" />
                            <RadioButton Content="Как в Windows" Style="{StaticResource PillSegment}" GroupName="Theme"
                                         IsChecked="{Binding IsThemeSystem, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock Text="Переменяется после перезапуска приложения." Style="{StaticResource Caption}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Border>

            <!-- ================= ВИДЕО, ОБРЕЗКА, АУДИО ================= -->
            <Border Style="{StaticResource GlassCardBorder}" Margin="0,0,0,12">
                <Border Style="{StaticResource GlassCard}" Padding="18,16" Margin="1">
                    <StackPanel>
                        <TextBlock Text="Видео, обрезка и аудио" Style="{StaticResource H3}" Margin="0,0,0,12" />

                        <TextBlock Text="Масштаб (--scale)" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Исходное" Style="{StaticResource PillSegment}" GroupName="Scale"
                                         IsChecked="{Binding IsScaleOriginal, Mode=TwoWay}" />
                            <RadioButton Content="1920x1080" Style="{StaticResource PillSegment}" GroupName="Scale"
                                         IsChecked="{Binding IsScale1080, Mode=TwoWay}" />
                            <RadioButton Content="2560x1440" Style="{StaticResource PillSegment}" GroupName="Scale"
                                         IsChecked="{Binding IsScale1440, Mode=TwoWay}" />
                            <RadioButton Content="3840x2160" Style="{StaticResource PillSegment}" GroupName="Scale"
                                         IsChecked="{Binding IsScale2160, Mode=TwoWay}" />
                            <RadioButton Content="WxH" Style="{StaticResource PillSegment}" GroupName="Scale"
                                         IsChecked="{Binding IsScaleCustom, Mode=TwoWay}" />
                            <TextBox Style="{StaticResource GlassTextBox}" Width="120" Margin="10,0,0,0"
                                     Text="{Binding Scale}" IsEnabled="{Binding IsScaleCustom}" />
                        </StackPanel>

                        <TextBlock Text="Обрезка фрагмента (--ss / --to, без перекодирования)" Style="{StaticResource Caption}"
                                   Margin="0,16,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="От" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource GlassTextBox}" Width="110" Text="{Binding CropStart}" />
                            <TextBlock Text="До" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <TextBox Style="{StaticResource GlassTextBox}" Width="110" Text="{Binding CropEnd}" />
                            <TextBlock Text="чч:мм:сс" Style="{StaticResource Caption}" Margin="10,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="Аудио" Style="{StaticResource Caption}" Margin="0,16,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Кодек" Style="{StaticResource Caption}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <RadioButton Content="copy" Style="{StaticResource PillSegment}" GroupName="AudioCodec"
                                         IsChecked="{Binding IsAudioCopy, Mode=TwoWay}" />
                            <RadioButton Content="AAC" Style="{StaticResource PillSegment}" GroupName="AudioCodec"
                                         IsChecked="{Binding IsAudioAac, Mode=TwoWay}" />
                            <RadioButton Content="OPUS" Style="{StaticResource PillSegment}" GroupName="AudioCodec"
                                         IsChecked="{Binding IsAudioOpus, Mode=TwoWay}" />
                            <TextBlock Text="Битрейт" Style="{StaticResource Caption}" Margin="16,0,8,0"
                                       VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource GlassTextBox}" Width="90" Text="{Binding AudioBitrate}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <CheckBox Content="--no-scene-detect (откл. поиск склеек)" Style="{StaticResource MiniToggle}"
                                      IsChecked="{Binding NoSceneDetect}" />
                            <CheckBox Content="--no-deinterlace" Style="{StaticResource MiniToggle}"
                                      IsChecked="{Binding NoDeinterlace}" Margin="16,0,0,0" />
                            <CheckBox Content="--no-color-metadata" Style="{StaticResource MiniToggle}"
                                      IsChecked="{Binding NoColorMetadata}" Margin="16,0,0,0" />
                            <CheckBox Content="-v (подробный лог)" Style="{StaticResource MiniToggle}"
                                      IsChecked="{Binding Verbose}" Margin="16,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ================= ПРОДВИНУТЫЕ ПАРАМЕТРЫ И ПУТИ ================= -->
            <Border Style="{StaticResource GlassCardBorder}" Margin="0,0,0,12">
                <Expander Header="Продвинутые параметры и пути"
                          IsExpanded="False"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          Margin="1" Padding="0">
                    <Border Style="{StaticResource GlassCard}" Padding="18,10,18,18" Margin="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="--crf" Style="{StaticResource Body}" />
                                <TextBox Grid.Column="1" Style="{StaticResource GlassTextBox}" Text="{Binding Crf}" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="--cq (NVENC)" Style="{StaticResource Body}" />
                                <TextBox Grid.Column="1" Style="{StaticResource GlassTextBox}" Text="{Binding Cq}" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="--gpu (индекс Vulkan)" Style="{StaticResource Body}" />
                                <TextBox Grid.Column="1" Style="{StaticResource GlassTextBox}" Text="{Binding GpuIndex}" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="--chunk-frames" Style="{StaticResource Body}" />
                                <TextBox Grid.Column="1" Style="{StaticResource GlassTextBox}" Text="{Binding ChunkFrames}" />
                            </Grid>

                            <TextBlock Text="Пути к инструментам" Style="{StaticResource Caption}" Margin="0,10,0,8" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="--ffmpeg" Style="{StaticResource Body}" />
                                <TextBox Grid.Column="1" Style="{StaticResource GlassTextBox}" Text="{Binding FfmpegPath}" />
                                <Button Grid.Column="2" Content="Обзор" Style="{StaticResource GhostButton}"
                                        Width="70" Margin="8,0,0,0" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="--ffprobe" Style="{StaticResource Body}" />
                                <TextBox Grid.Column="1" Style="{StaticResource GlassTextBox}" Text="{Binding FfprobePath}" />
                                <Button Grid.Column="2" Content="Обзор" Style="{StaticResource GhostButton}"
                                        Width="70" Margin="8,0,0,0" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="--rife" Style="{StaticResource Body}" />
                                <TextBox Grid.Column="1" Style="{StaticResource GlassTextBox}" Text="{Binding RifePath}" />
                                <Button Grid.Column="2" Content="Обзор" Style="{StaticResource GhostButton}"
                                        Width="70" Margin="8,0,0,0" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="--models-dir" Style="{StaticResource Body}" />
                                <TextBox Grid.Column="1" Style="{StaticResource GlassTextBox}" Text="{Binding ModelsDir}" />
                                <Button Grid.Column="2" Content="Обзор" Style="{StaticResource GhostButton}"
                                        Width="70" Margin="8,0,0,0" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Открыть папку настроек" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding OpenSettingsFolderCommand}" />
                                <Button Content="Открыть папку моделей" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding OpenModelsFolderCommand}" Margin="12,0,0,0" />
                                <Button Content="Сбросить настройки" Style="{StaticResource GhostButton}"
                                        Command="{Binding ResetCommand}" Margin="12,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="Хранилище: %LOCALAPPDATA%\\RTX Media Master\\settings.json"
                                       Style="{StaticResource Caption}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Expander>
            </Border>

            <Button Content="Сохранить настройки" Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
