<UserControl x:Class="RTXMediaMaster.Gui.Views.SettingsView"             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"             xmlns:vm="clr-namespace:RTXMediaMaster.Gui.ViewModels"             xmlns:conv="clr-namespace:RTXMediaMaster.Gui.Converters">    <UserControl.Resources>        <conv:BoolToVisibilityConverter x:Key="B2V" />        <conv:NullToVisibilityConverter x:Key="N2V" />    </UserControl.Resources>    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12,16,16">        <StackPanel>            <!-- ================= ╨Ю╨д╨Ю╨а╨Ь╨Ы╨Х╨Э╨Ш╨Х ================= -->            <Border Style="{StaticResource GlassCardBorder}" Margin="0,0,0,12">                <Border Style="{StaticResource GlassCard}" Padding="18,16" Margin="1">                    <StackPanel>                        <TextBlock Text="╨в╨╡╨╝╨░ ╨╛╤Д╨╛╤А╨╝╨╗╨╡╨╜╨╕╤П" Style="{StaticResource H3}" Margin="0,0,0,10" />                        <StackPanel Orientation="Horizontal">                            <RadioButton Content="╨в╤С╨╝╨╜╨░╤П" Style="{StaticResource PillSegment}" GroupName="Theme"                                         IsChecked="{Binding IsThemeDark, Mode=TwoWay}" />                            <RadioButton Content="╨б╨▓╨╡╤В╨╗╨░╤П" Style="{StaticResource PillSegment}" GroupName="Theme"                                         IsChecked="{Binding IsThemeLight, Mode=TwoWay}" />                            <RadioButton Content="╨Ъ╨░╨║ ╨▓ Windows" Style="{StaticResource PillSegment}" GroupName="Theme"                                         IsChecked="{Binding IsThemeSystem, Mode=TwoWay}" />                        </StackPanel>                        <TextBlock Text="╨Я╨╡╤А╨╡╨╝╨╡╨╜╤П╨╡╤В╤Б╤П ╨┐╨╛╤Б╨╗╨╡ ╨┐╨╡╤А╨╡╨╖╨░╨┐╤Г╤Б╨║╨░ ╨┐╤А╨╕╨╗╨╛╨╢╨╡╨╜╨╕╤П." Style="{StaticResource Caption}"                                   Margin="0,8,0,0" />                    </StackPanel>                </Border>            </Border>            <!-- ================= ╨Т╨Ш╨Ф╨Х╨Ю, ╨Ю╨С╨а╨Х╨Ч╨Ъ╨Р, ╨Р╨г╨Ф╨Ш╨Ю ================= -->            <Border Style="{StaticResource GlassCardBorder}" Margin="0,0,0,12">                <Border Style="{StaticResource GlassCard}" Padding="18,16" Margin="1">                    <StackPanel>                        <TextBlock Text="╨Т╨╕╨┤╨╡╨╛, ╨╛╨▒╤А╨╡╨╖╨║╨░ ╨╕ ╨░╤Г╨┤╨╕╨╛" Style="{StaticResource H3}" Margin="0,0,0,12" />                        <TextBlock Text="╨Ь╨░╤Б╤И╤В╨░╨▒ (--scale)" Style="{StaticResource Caption}" Margin="0,0,0,8" />                        <StackPanel Orientation="Horizontal">                            <RadioButton Content="╨Ш╤Б╤Е╨╛╨┤╨╜╨╛╨╡" Style="{StaticResource PillSegment}" GroupName="Scale"                                         IsChecked="{Binding IsScaleOriginal, Mode=TwoWay}" />                            <RadioButton Content="1920x1080" Style="{StaticResource PillSegment}" GroupName="Scale"                                         IsChecked="{Binding IsScale1080, Mode=TwoWay}" />                            <RadioButton Content="2560x1440" Style="{StaticResource PillSegment}" GroupName="Scale"                                         IsChecked="{Binding IsScale1440, Mode=TwoWay}" />                            <RadioButton Content="3840x2160" Style="{StaticResource PillSegment}" GroupName="Scale"                                         IsChecked="{Binding IsScale2160, Mode=TwoWay}" />                            <RadioButton Content="WxH" Style="{StaticResource PillSegment}" GroupName="Scale"                                         IsChecked="{Binding IsScaleCustom, Mode=TwoWay}" />                            <TextBox Style="{StaticResource GlassTextBox}" Width="120" Margin="10,0,0,0"                                     Text="{Binding Scale}" IsEnabled="{Binding IsScaleCustom}" />                        </StackPanel>                        <TextBlock Text="╨Ю╨▒╤А╨╡╨╖╨║╨░ ╤Д╤А╨░╨│╨╝╨╡╨╜╤В╨░ (--ss / --to, ╨▒╨╡╨╖ ╨┐╨╡╤А╨╡╨║╨╛╨┤╨╕╤А╨╛╨▓╨░╨╜╨╕╤П)" Style="{StaticResource Caption}"                                   Margin="0,16,0,8" />                        <StackPanel Orientation="Horizontal">                            <TextBlock Text="╨Ю╤В" Style="{StaticResource Caption}" VerticalAlignment="Center" />                            <TextBox Style="{StaticResource GlassTextBox}" Width="110" Text="{Binding CropStart}" />                            <TextBlock Text="╨Ф╨╛" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0" />                            <TextBox Style="{StaticResource GlassTextBox}" Width="110" Text="{Binding CropEnd}" />                            <TextBlock Text="╤З╤З:╨╝╨╝:╤Б╤Б" Style="{StaticResource Caption}" Margin="10,0,0,0" />                        </StackPanel>                        <TextBlock Text="╨Р╤Г╨┤╨╕╨╛" Style="{StaticResource Caption}" Margin="0,16,0,8" />                        <StackPanel Orientation="Horizontal">                            <TextBlock Text="╨Ъ╨╛╨┤╨╡╨║" Style="{StaticResource Caption}" Margin="0,0,8,0" VerticalAlignment="Center" />                            <RadioButton Content="copy" Style="{StaticResource PillSegment}" GroupName="AudioCodec"                                         IsChecked="{Binding IsAudioCopy, Mode=TwoWay}" />                            <RadioButton Content="AAC" Style="{StaticResource PillSegment}" GroupName="AudioCodec"                                         IsChecked="{Binding IsAudioAac, Mode=TwoWay}" />                            <RadioButton Content="OPUS" Style="{StaticResource PillSegment}" GroupName="AudioCodec"                                         IsChecked="{Binding IsAudioOpus, Mode=TwoWay}" />                            <TextBlock Text="╨С╨╕╤В╤А╨╡╨╣╤В" Style="{StaticResource Caption}" Margin="16,0,8,0"                                       VerticalAlignment="Center" />                            <TextBox Style="{StaticResource GlassTextBox}" Width="90" Text="{Binding AudioBitrate}" />                        </StackPanel>                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">                            <CheckBox Content="--no-scene-detect (╨╛╤В╨║╨╗. ╨┐╨╛╨╕╤Б╨║ ╤Б╨║╨╗╨╡╨╡╨║)" Style="{StaticResource MiniToggle}"                                      IsChecked="{Binding NoSceneDetect}" />                            <CheckBox Content="--no-deinterlace" Style="{StaticResource MiniToggle}"                                      IsChecked="{Binding NoDeinterlace}" Margin="16,0,0,0" />                            <CheckBox Content="--no-color-metadata" Style="{StaticResource MiniToggle}"                                      IsChecked="{Binding NoColorMetadata}" Margin="16,0,0,0" />                            <CheckBox Content="-v (╨┐╨╛╨┤╤А╨╛╨▒╨╜╤Л╨╣ ╨╗╨╛╨│)" Style="{StaticResource MiniToggle}"                                      IsChecked="{Binding Verbose}" Margin="16,0,0,0" />                        </StackPanel>                    </StackPanel>                </Border>            </Border>            <!-- ================= ╨Я╨а╨Ю╨Ф╨Т╨Ш╨Э╨г╨в╨л╨Х ╨Я╨Р╨а╨Р╨Ь╨Х╨в╨а╨л ╨Ш ╨Я╨г╨в╨Ш ================= -->            <Border Style="{StaticResource GlassCardBorder}" Margin="0,0,0,12">                <Expander Header="╨Я╤А╨╛╨┤╨▓╨╕╨╜╤Г╤В╤Л╨╡ ╨┐╨░╤А╨░╨╝╨╡╤В╤А╤Л ╨╕ ╨┐╤Г╤В╨╕"                          IsExpanded="False"                          Foreground="{StaticResource TextPrimaryBrush}"                          Margin="1" Padding="0">                    <Border Style="{StaticResource GlassCard}" Padding="18,10,18,18" Margin="1">                        <StackPanel>                            <Grid Margin="0,0,0,12">                                <Grid.ColumnDefinitions>                                    <ColumnDefinition Width="220" />                                    <ColumnDefinition Width="*" />                                </Grid.ColumnDefinitions>                                <TextBlock Grid.Column="0" Text="--crf" Style="{StaticResource Body}" />                                <TextBox Grid.Column="1" Style="{StaticResource GlassTextBox}" Text="{Binding Crf}" />                            </Grid>                            <Grid Margin="0,0,0,12">                                <Grid.ColumnDefinitions>                                    <ColumnDefinition Width="220" />                                    <ColumnDefinition Width="*" />                                </Grid.ColumnDefinitions>                                <TextBlock Grid.Column="0" Text="--cq (NVENC)" Style="{StaticResource Body}" />                                <TextBox Grid.Column="1" Style="{StaticResource GlassTextBox}" Text="{Binding Cq}" />                            </Grid>                            <Grid Margin="0,0,0,12">                                <Grid.ColumnDefinitions>                                    <ColumnDefinition Width="220" />                                    <ColumnDefinition Width="*" />                                </Grid.ColumnDefinitions>                                <TextBlock Grid.Column="0" Text="--gpu (╨╕╨╜╨┤╨╡╨║╤Б Vulkan)" Style="{StaticResource Body}" />                                <TextBox Grid.Column="1" Style="{StaticResource GlassTextBox}" Text="{Binding GpuIndex}" />                            </Grid>                            <Grid Margin="0,0,0,12">                                <Grid.ColumnDefinitions>                                    <ColumnDefinition Width="220" />                                    <ColumnDefinition Width="*" />                                </Grid.ColumnDefinitions>                                <TextBlock Grid.Column="0" Text="--chunk-frames" Style="{StaticResource Body}" />                                <TextBox Grid.Column="1" Style="{StaticResource GlassTextBox}" Text="{Binding ChunkFrames}" />                            </Grid>                            <TextBlock Text="╨Я╤Г╤В╨╕ ╨║ ╨╕╨╜╤Б╤В╤А╤Г╨╝╨╡╨╜╤В╨░╨╝" Style="{StaticResource Caption}" Margin="0,10,0,8" />                            <Grid Margin="0,0,0,8">                                <Grid.ColumnDefinitions>                                    <ColumnDefinition Width="220" />                                    <ColumnDefinition Width="*" />                                    <ColumnDefinition Width="Auto" />                                </Grid.ColumnDefinitions>                                <TextBlock Grid.Column="0" Text="--ffmpeg" Style="{StaticResource Body}" />                                <TextBox Grid.Column="1" Style="{StaticResource GlassTextBox}" Text="{Binding FfmpegPath}" />                                <Button Grid.Column="2" Content="╨Ю╨▒╨╖╨╛╤А" Style="{StaticResource GhostButton}"                                        Width="70" Margin="8,0,0,0" Tag="Ffmpeg" Click="BrowsePath_Click" />                            </Grid>                            <Grid Margin="0,0,0,8">                                <Grid.ColumnDefinitions>                                    <ColumnDefinition Width="220" />                                    <ColumnDefinition Width="*" />                                    <ColumnDefinition Width="Auto" />                                </Grid.ColumnDefinitions>                                <TextBlock Grid.Column="0" Text="--ffprobe" Style="{StaticResource Body}" />                                <TextBox Grid.Column="1" Style="{StaticResource GlassTextBox}" Text="{Binding FfprobePath}" />                                <Button Grid.Column="2" Content="╨Ю╨▒╨╖╨╛╤А" Style="{StaticResource GhostButton}"                                        Width="70" Margin="8,0,0,0" Tag="Ffprobe" Click="BrowsePath_Click" />                            </Grid>                            <Grid Margin="0,0,0,8">                                <Grid.ColumnDefinitions>                                    <ColumnDefinition Width="220" />                                    <ColumnDefinition Width="*" />                                    <ColumnDefinition Width="Auto" />                                </Grid.ColumnDefinitions>                                <TextBlock Grid.Column="0" Text="--rife" Style="{StaticResource Body}" />                                <TextBox Grid.Column="1" Style="{StaticResource GlassTextBox}" Text="{Binding RifePath}" />                                <Button Grid.Column="2" Content="╨Ю╨▒╨╖╨╛╤А" Style="{StaticResource GhostButton}"                                        Width="70" Margin="8,0,0,0" Tag="Rife" Click="BrowsePath_Click" />                            </Grid>                            <Grid Margin="0,0,0,8">                                <Grid.ColumnDefinitions>                                    <ColumnDefinition Width="220" />                                    <ColumnDefinition Width="*" />                                    <ColumnDefinition Width="Auto" />                                </Grid.ColumnDefinitions>                                <TextBlock Grid.Column="0" Text="--models-dir" Style="{StaticResource Body}" />                                <TextBox Grid.Column="1" Style="{StaticResource GlassTextBox}" Text="{Binding ModelsDir}" />                                <Button Grid.Column="2" Content="╨Ю╨▒╨╖╨╛╤А" Style="{StaticResource GhostButton}"                                        Width="70" Margin="8,0,0,0" Tag="Models" Click="BrowsePath_Click" />                            </Grid>                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">                                <Button Content="╨Ю╤В╨║╤А╤Л╤В╤М ╨┐╨░╨┐╨║╤Г ╨╜╨░╤Б╤В╤А╨╛╨╡╨║" Style="{StaticResource SecondaryButton}"                                        Command="{Binding OpenSettingsFolderCommand}" />                                <Button Content="╨Ю╤В╨║╤А╤Л╤В╤М ╨┐╨░╨┐╨║╤Г ╨╝╨╛╨┤╨╡╨╗╨╡╨╣" Style="{StaticResource SecondaryButton}"                                        Command="{Binding OpenModelsFolderCommand}" Margin="12,0,0,0" />                                <Button Content="╨б╨▒╤А╨╛╤Б╨╕╤В╤М ╨╜╨░╤Б╤В╤А╨╛╨╣╨║╨╕" Style="{StaticResource GhostButton}"                                        Command="{Binding ResetCommand}" Margin="12,0,0,0" />                            </StackPanel>                            <TextBlock Text="╨е╤А╨░╨╜╨╕╨╗╨╕╤Й╨╡: %LOCALAPPDATA%\\RTX Media Master\\settings.json"                                       Style="{StaticResource Caption}" Margin="0,8,0,0" />                        </StackPanel>                    </Border>                </Expander>            </Border>            <Button Content="╨б╨╛╤Е╤А╨░╨╜╨╕╤В╤М ╨╜╨░╤Б╤В╤А╨╛╨╣╨║╨╕" Style="{StaticResource PrimaryButton}"                    Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />        </StackPanel>    </ScrollViewer></UserControl>