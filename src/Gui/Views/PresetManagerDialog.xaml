<Window x:Class="RTXMediaMaster.Gui.Views.PresetManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер пресетов"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Width="480" Height="360"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStyle="None">
    <Border Style="{StaticResource GlassCardBorder}" CornerRadius="14">
        <Border Style="{StaticResource GlassCard}" CornerRadius="14" Padding="20" Margin="1">
            <StackPanel>
                <TextBlock Text="Менеджер пресетов" Style="{StaticResource H3}" Margin="0,0,0,12" />
                <TextBlock Text="Сохранённые профили (TargetFPS, Профиль, Кодек, Улучшение, Масштаб, Действие после завершения)"
                           Style="{StaticResource Caption}" Margin="0,0,0,8" />
                <ListBox x:Name="PresetsList" Height="140"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Body}" Margin="0,4" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBox x:Name="PresetName" Style="{StaticResource GlassTextBox}"
                         Margin="0,10,0,0" ToolTip="Имя нового пресета" />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Сохранить" Style="{StaticResource PrimaryButton}"
                            Click="Save_Click" Width="100" />
                    <Button Content="Загрузить" Style="{StaticResource SecondaryButton}"
                            Click="Load_Click" Width="90" Margin="12,0,0,0" />
                    <Button Content="Удалить" Style="{StaticResource GhostButton}"
                            Click="Delete_Click" Width="90" Margin="12,0,0,0" />
                </StackPanel>
                <Button Content="Закрыть" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Right" Margin="0,16,0,0" Click="Close_Click" />
            </StackPanel>
        </Border>
    </Border>
</Window>
