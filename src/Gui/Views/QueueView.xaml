<UserControl x:Class="RTXMediaMaster.Gui.Views.QueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RTXMediaMaster.Gui.ViewModels"
             xmlns:conv="clr-namespace:RTXMediaMaster.Gui.Converters">    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="B2V" />
        <conv:NullToVisibilityConverter x:Key="N2V" />
        <conv:InverseBoolConverter x:Key="InvB" />
        <conv:StatusToBrushConverter x:Key="S2B" />
        <conv:ItemStatusToBrushConverter x:Key="IS2B" />
        <conv:DoubleToPercentConverter x:Key="D2P" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= ВЕРХНЯЯ ПАНЕЛЬ ОЧЕРЕДИ ================= -->
        <Border Grid.Row="0" Style="{StaticResource GlassCardBorder}">
            <Border Style="{StaticResource GlassCard}" Padding="0">
                <Grid Margin="16,14,16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox Style="{StaticResource GlassTextBox}" Width="260"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <Button Grid.Column="1" Content="+ Добавить видео" Style="{StaticResource SecondaryButton}"
                            Command="{Binding AddFilesCommand}" />
                    <Button Grid.Column="2" Content="Папка" Style="{StaticResource SecondaryButton}"
                            Command="{Binding AddFolderCommand}" />
                    <Button Grid.Column="3" Content="Менеджер пресетов" Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenPresetManagerCommand}" />

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="После завершения:" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <RadioButton Content="Ничего" Style="{StaticResource PillSegment}" GroupName="After"
                                     IsChecked="{Binding IsAfterNone, Mode=TwoWay}" />
                        <RadioButton Content="Уведомл." Style="{StaticResource PillSegment}" GroupName="After"
                                     IsChecked="{Binding IsAfterNotify, Mode=TwoWay}" />
                        <RadioButton Content="Сон" Style="{StaticResource PillSegment}" GroupName="After"
                                     IsChecked="{Binding IsAfterSleep, Mode=TwoWay}" />
                        <RadioButton Content="Выкл." Style="{StaticResource PillSegment}" GroupName="After"
                                     IsChecked="{Binding IsAfterShutdown, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Запустить" Style="{StaticResource PrimaryButton}"
                                Command="{Binding StartAllCommand}"
                                IsEnabled="{Binding IsEmpty, Converter={StaticResource InvB}}" />
                        <Button Content="Отмена" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelAllCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- ================= СОДЕРЖИМОЕ ================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Padding="16,12,16,0">
            <StackPanel>

                <!-- Пустая очередь — Hero Dropzone -->
                <Border Style="{StaticResource GlassCardBorder}" Visibility="{Binding IsEmpty, Converter={StaticResource B2V}}"
                        AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop"
                        DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave"
                        x:Name="HeroDropZone">
                    <Border Style="{StaticResource GlassCard}" Padding="40,30" Margin="1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="72" Height="72" CornerRadius="36" Background="#1A1F26"
                                    HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="⌄" FontSize="30" Foreground="#7A8294"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Перетащите видео или папку сюда" Style="{StaticResource H3}"
                                       HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <TextBlock Text="Поддерживается перетаскивание файлов и целых папок с видео"
                                       Style="{StaticResource BodyMuted}" HorizontalAlignment="Center" Margin="0,0,0,22" />
                            <Button Content="+ Добавить видео" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding AddFilesCommand}" Width="200" />
                        </StackPanel>
                    </Border>
                </Border>

                <!-- Список карточек очереди -->
                <ItemsControl ItemsSource="{Binding FilteredItems}" Visibility="{Binding IsEmpty, Converter={StaticResource InvB}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GlassCardBorder}" Margin="0,0,0,10">
                                <Border Style="{StaticResource GlassCard}" Padding="16,14" Margin="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Миниатюра -->
                                        <Border Grid.Column="0" Width="88" Height="56" CornerRadius="8"
                                                Background="#161A20" Margin="0,0,14,0">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                       Visibility="{Binding Thumbnail, Converter={StaticResource N2V}}" />
                                                <TextBlock Text="▶" Foreground="#7A8294" FontSize="20"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding Thumbnail, Converter={StaticResource N2V}, ConverterParameter=invert}" />
                                            </Grid>
                                        </Border>

                                        <!-- Информация -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" Style="{StaticResource H3}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ResolutionLabel}" Style="{StaticResource Caption}"
                                                       Margin="0,2,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Border Background="#161A20" CornerRadius="10" Padding="6,2">
                                                    <TextBlock Text="{Binding DurationText}" Style="{StaticResource Caption}"
                                                               Foreground="#B9C0CC" />
                                                </Border>
                                                <Border Background="#FBBF24" CornerRadius="10"
                                                        Padding="6,2" Visibility="{Binding IsVfr, Converter={StaticResource B2V}}">
                                                    <TextBlock Text="VFR" Style="{StaticResource Caption}" Foreground="#0B0D10" />
                                                </Border>
                                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                            <ProgressBar Style="{StaticResource GlassProgressBar}"
                                                         Value="{Binding Progress}" Maximum="100" Margin="0,8,0,0"
                                                         Visibility="{Binding IsProcessing, Converter={StaticResource B2V}}" />
                                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}"
                                                       Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Stage}" Style="{StaticResource Caption}"
                                                       Margin="0,2,0,0" Foreground="#7A8294" />
                                            <TextBlock Text="{Binding Error}" Style="{StaticResource Caption}"
                                                       Foreground="#F87171" Visibility="{Binding Error, Converter={StaticResource N2V}}" />
                                        </StackPanel>

                                        <!-- Действия карточки -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Тест 5 сек" Style="{StaticResource GhostButton}"
                                                    Command="{Binding TestCommand}"
                                                    IsEnabled="{Binding CanTest}" Width="80" />
                                            <Button Content="Папка" Style="{StaticResource GhostButton}"
                                                    Command="{Binding OpenFolderCommand}" Width="70" />
                                            <Button Content="✕" Style="{StaticResource GhostButton}"
                                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Width="34"
                                                    IsEnabled="{Binding CanRemove}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= БЫСТРЫЕ НАСТРОЙКИ (pilly) ================= -->
        <Border Grid.Row="2" Style="{StaticResource GlassCardBorder}" Margin="16,12,16,16">
            <Border Style="{StaticResource GlassCard}" Padding="18,14" Margin="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Целевой FPS -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Целевой FPS" Style="{StaticResource Caption}" Margin="0,0,10,0" />
                        <RadioButton Content="60" Style="{StaticResource PillSegment}" GroupName="Fps"
                                     IsChecked="{Binding IsFps60, Mode=TwoWay}" />
                        <RadioButton Content="120" Style="{StaticResource PillSegment}" GroupName="Fps"
                                     IsChecked="{Binding IsFps120, Mode=TwoWay}" />
                        <RadioButton Content="2x" Style="{StaticResource PillSegment}" GroupName="Fps"
                                     IsChecked="{Binding IsFps2x, Mode=TwoWay}" />
                        <RadioButton Content="3x" Style="{StaticResource PillSegment}" GroupName="Fps"
                                     IsChecked="{Binding IsFps3x, Mode=TwoWay}" />
                        <TextBox Style="{StaticResource GlassTextBox}" Width="80" Margin="12,0,0,0"
                                 Text="{Binding TargetFps}" />
                    </StackPanel>

                    <!-- Профиль -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                        <TextBlock Text="Профиль" Style="{StaticResource Caption}" Margin="0,0,10,0" />
                        <RadioButton Content="Компакт" Style="{StaticResource PillSegment}" GroupName="Preset"
                                     IsChecked="{Binding IsPresetCompact, Mode=TwoWay}" />
                        <RadioButton Content="Баланс" Style="{StaticResource PillSegment}" GroupName="Preset"
                                     IsChecked="{Binding IsPresetBalanced, Mode=TwoWay}" />
                        <RadioButton Content="Качество" Style="{StaticResource PillSegment}" GroupName="Preset"
                                     IsChecked="{Binding IsPresetQuality, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- Кодек + Enhance -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                        <TextBlock Text="Кодек" Style="{StaticResource Caption}" Margin="0,0,10,0" />
                        <RadioButton Content="Авто" Style="{StaticResource PillSegment}" GroupName="Codec"
                                     IsChecked="{Binding IsCodecAuto, Mode=TwoWay}" />
                        <RadioButton Content="AV1" Style="{StaticResource PillSegment}" GroupName="Codec"
                                     IsChecked="{Binding IsCodecAv1, Mode=TwoWay}" />
                        <RadioButton Content="HEVC" Style="{StaticResource PillSegment}" GroupName="Codec"
                                     IsChecked="{Binding IsCodecHevc, Mode=TwoWay}" />
                        <CheckBox Content="Улучшение (Denoise + CAS)" Style="{StaticResource PillToggle}"
                                  IsChecked="{Binding Enhance}" Margin="20,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
