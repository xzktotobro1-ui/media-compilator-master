<UserControl x:Class="RTXMediaMaster.Gui.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RTXMediaMaster.Gui.ViewModels"
             xmlns:conv="clr-namespace:RTXMediaMaster.Gui.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="B2V" />
        <conv:LogLevelToBrushConverter x:Key="S2B" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource GlassCardBorder}" Margin="0,0,0,8">
            <Border Style="{StaticResource GlassCard}" Padding="14,12" Margin="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource GlassTextBox}" Width="260"
                             Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Поиск по сообщениям лога" />
                    <Button Grid.Column="1" Content="Экспорт в .txt" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ExportCommand}" Width="110" />
                    <Button Grid.Column="2" Content="Копировать CLI" Style="{StaticResource SecondaryButton}"
                            Command="{Binding CopyCliCommand}" Width="110" />
                    <Button Grid.Column="3" Content="Очистить лог" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ClearCommand}" Width="100" />
                </Grid>
            </Border>
        </Border>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Filtered}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="6,2" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Time, StringFormat={}{0:HH:mm:ss}}"
                                       Style="{StaticResource Caption}" Foreground="#7A8294" FontFamily="{StaticResource MonoFont}" />
                            <TextBlock Grid.Column="1" Text="{Binding Level}" Style="{StaticResource Caption}"
                                       Margin="8,0,0,0" FontFamily="{StaticResource MonoFont}" FontWeight="Bold"
                                       Foreground="{Binding Level, Converter={StaticResource S2B}}" />
                            <TextBlock Grid.Column="2" Text="{Binding Message}" Style="{StaticResource Body}"
                                       Margin="8,0,0,0" FontFamily="{StaticResource MonoFont}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="2" Style="{StaticResource GlassCardBorder}" Visibility="{Binding Verification.Count, Converter={StaticResource B2V}}">
            <Border Style="{StaticResource GlassCard}" Padding="14,10" Margin="1">
                <StackPanel>
                    <TextBlock Text="Итоговая проверка (ffprobe)" Style="{StaticResource H3}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Verification}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Key}" Style="{StaticResource Caption}" Foreground="#7A8294" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Caption}"
                                               Foreground="#34D399" FontFamily="{StaticResource MonoFont}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
