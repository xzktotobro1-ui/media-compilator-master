<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"                    xmlns:conv="clr-namespace:RTXMediaMaster.Gui.Converters">    <conv:StepActiveConverter x:Key="StepActive" />    <!-- ====================== ╨Я╨Р╨Ы╨Ш╨в╨а╨Р ====================== -->    <Color x:Key="BgColor">#0B0D10</Color>    <Color x:Key="CardColor">#CC141820</Color>    <Color x:Key="CardBorderTopColor">#1AFFFFFF</Color>    <Color x:Key="CardBorderBottomColor">#08FFFFFF</Color>    <Color x:Key="RaisedColor">#1A1F26</Color>    <Color x:Key="TextPrimary">#FFFFFF</Color>    <Color x:Key="TextSecondary">#B9C0CC</Color>    <Color x:Key="TextMuted">#7A8294</Color>    <Color x:Key="AccentStart">#76B900</Color>    <Color x:Key="AccentEnd">#00D2FF</Color>    <Color x:Key="PillActive">#3A4150</Color>    <Color x:Key="PillHover">#2A313C</Color>    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource BgColor}" />    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardColor}" />    <SolidColorBrush x:Key="CardBorderTopBrush" Color="{StaticResource CardBorderTopColor}" />    <SolidColorBrush x:Key="CardBorderBottomBrush" Color="{StaticResource CardBorderBottomColor}" />    <SolidColorBrush x:Key="RaisedControlBrush" Color="{StaticResource RaisedColor}" />    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />    <SolidColorBrush x:Key="PillActiveBrush" Color="{StaticResource PillActive}" />    <SolidColorBrush x:Key="PillHoverBrush" Color="{StaticResource PillHover}" />    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">        <GradientStop Color="{StaticResource AccentStart}" Offset="0" />        <GradientStop Color="{StaticResource AccentEnd}" Offset="1" />    </LinearGradientBrush>    <LinearGradientBrush x:Key="CardBorderGradientBrush" StartPoint="0,0" EndPoint="0,1">        <GradientStop Color="{StaticResource CardBorderTopColor}" Offset="0" />        <GradientStop Color="{StaticResource CardBorderBottomColor}" Offset="1" />    </LinearGradientBrush>    <!-- ====================== ╨и╨а╨Ш╨д╨в╨л ====================== -->    <FontFamily x:Key="UiFont">Segoe UI Variable, Segoe UI</FontFamily>    <FontFamily x:Key="MonoFont">Consolas, Cascadia Mono</FontFamily>    <!-- ====================== ╨Ю╨Ъ╨Э╨Ю ====================== -->    <Style x:Key="StudioWindow" TargetType="Window">        <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />        <Setter Property="FontSize" Value="13" />        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />    </Style>    <!-- ====================== ╨Ъ╨Р╨а╨в╨Ю╨з╨Ъ╨Р (╤Б╤В╨╡╨║╨╗╨╛) ====================== -->    <Style x:Key="GlassCard" TargetType="Border">        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />        <Setter Property="CornerRadius" Value="12" />        <Setter Property="Padding" Value="18" />        <Setter Property="SnapsToDevicePixels" Value="True" />        <Setter Property="RenderOptions.EdgeMode" Value="Aliased" />    </Style>    <Style x:Key="GlassCardBorder" TargetType="Border">        <Setter Property="CornerRadius" Value="12" />        <Setter Property="Padding" Value="1" />        <Setter Property="Background" Value="{StaticResource CardBorderGradientBrush}" />    </Style>    <!-- ====================== ╨в╨Х╨Ъ╨б╨в ====================== -->    <Style x:Key="H3" TargetType="TextBlock">        <Setter Property="FontSize" Value="14" />        <Setter Property="FontWeight" Value="SemiBold" />        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />    </Style>    <Style x:Key="Caption" TargetType="TextBlock">        <Setter Property="FontSize" Value="11" />        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />    </Style>    <Style x:Key="Body" TargetType="TextBlock">        <Setter Property="FontSize" Value="13" />        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />    </Style>    <Style x:Key="BodyMuted" TargetType="TextBlock" BasedOn="{StaticResource Body}">        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />    </Style>    <Style x:Key="StepLabel" TargetType="TextBlock">        <Setter Property="FontSize" Value="12" />        <Setter Property="FontWeight" Value="Medium" />        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />    </Style>    <Style x:Key="StepArrow" TargetType="TextBlock">        <Setter Property="FontSize" Value="12" />        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />    </Style>    <!-- ====================== ╨Ъ╨Э╨Ю╨Я╨Ъ╨Р ╨Ю╨б╨Э╨Ю╨Т╨Э╨Р╨п (╨│╤А╨░╨┤╨╕╨╡╨╜╤В RTX) ====================== -->    <Style x:Key="PrimaryButton" TargetType="Button">        <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />        <Setter Property="BorderThickness" Value="0" />        <Setter Property="Padding" Value="16,8" />        <Setter Property="FontWeight" Value="SemiBold" />        <Setter Property="Cursor" Value="Hand" />        <Setter Property="Template">            <Setter.Value>                <ControlTemplate TargetType="Button">                    <Border x:Name="Root" Background="{TemplateBinding Background}"                            CornerRadius="8" Padding="{TemplateBinding Padding}">                        <Border.Effect>                            <DropShadowEffect Color="#00D2FF" Direction="0" ShadowDepth="0" BlurRadius="14" Opacity="0.45" />                        </Border.Effect>                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />                    </Border>                    <ControlTemplate.Triggers>                        <Trigger Property="IsMouseOver" Value="True">                            <Setter TargetName="Root" Property="Effect">                                <Setter.Value>                                    <DropShadowEffect Color="#00D2FF" Direction="0" ShadowDepth="0" BlurRadius="22" Opacity="0.65" />                                </Setter.Value>                            </Setter>                        </Trigger>                        <Trigger Property="IsPressed" Value="True">                            <Setter TargetName="Root" Property="Opacity" Value="0.85" />                        </Trigger>                        <Trigger Property="IsEnabled" Value="False">                            <Setter Property="Opacity" Value="0.4" />                        </Trigger>                    </ControlTemplate.Triggers>                </ControlTemplate>            </Setter.Value>        </Setter>    </Style>    <!-- ====================== ╨Ъ╨Э╨Ю╨Я╨Ъ╨Р ╨Я╨а╨Ш╨Я╨Ю╨Ф╨Э╨п╨в╨Р╨п (╨▓╤В╨╛╤А╨╕╤З╨╜╨░╤П) ====================== -->    <Style x:Key="SecondaryButton" TargetType="Button">        <Setter Property="Background" Value="{StaticResource RaisedControlBrush}" />        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />        <Setter Property="BorderThickness" Value="0" />        <Setter Property="Padding" Value="12,7" />        <Setter Property="FontWeight" Value="Medium" />        <Setter Property="Cursor" Value="Hand" />        <Setter Property="Template">            <Setter.Value>                <ControlTemplate TargetType="Button">                    <Border x:Name="Root" Background="{TemplateBinding Background}"                            CornerRadius="8" Padding="{TemplateBinding Padding}">                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />                    </Border>                    <ControlTemplate.Triggers>                        <Trigger Property="IsMouseOver" Value="True">                            <Setter TargetName="Root" Property="Background" Value="#2A313C" />                        </Trigger>                        <Trigger Property="IsPressed" Value="True">                            <Setter TargetName="Root" Property="Opacity" Value="0.8" />                        </Trigger>                    </ControlTemplate.Triggers>                </ControlTemplate>            </Setter.Value>        </Setter>    </Style>    <!-- ====================== GHOST ╨Ъ╨Э╨Ю╨Я╨Ъ╨Р ====================== -->    <Style x:Key="GhostButton" TargetType="Button">        <Setter Property="Background" Value="Transparent" />        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />        <Setter Property="BorderThickness" Value="0" />        <Setter Property="Padding" Value="10,6" />        <Setter Property="Cursor" Value="Hand" />        <Setter Property="Template">            <Setter.Value>                <ControlTemplate TargetType="Button">                    <Border x:Name="Root" Background="Transparent"                            CornerRadius="8" Padding="{TemplateBinding Padding}">                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />                    </Border>                    <ControlTemplate.Triggers>                        <Trigger Property="IsMouseOver" Value="True">                            <Setter TargetName="Root" Property="Background" Value="#1A1F26" />                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />                        </Trigger>                    </ControlTemplate.Triggers>                </ControlTemplate>            </Setter.Value>        </Setter>    </Style>    <!-- ====================== K╨Э╨Ю╨Я╨Ъ╨Ш ╨г╨Я╨а╨Р╨Т╨Ы╨Х╨Э╨Ш╨п ╨Ю╨Ъ╨Э╨Ю╨Ь ====================== -->    <Style x:Key="WinButton" TargetType="Button">        <Setter Property="Background" Value="Transparent" />        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />        <Setter Property="BorderThickness" Value="0" />        <Setter Property="Width" Value="34" />        <Setter Property="Height" Value="28" />        <Setter Property="Padding" Value="0" />        <Setter Property="FontSize" Value="13" />        <Setter Property="Cursor" Value="Hand" />        <Setter Property="Template">            <Setter.Value>                <ControlTemplate TargetType="Button">                    <Border x:Name="Root" Background="{TemplateBinding Background}"                            CornerRadius="6">                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />                    </Border>                    <ControlTemplate.Triggers>                        <Trigger Property="IsMouseOver" Value="True">                            <Setter TargetName="Root" Property="Background" Value="#1A1F26" />                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />                        </Trigger>                    </ControlTemplate.Triggers>                </ControlTemplate>            </Setter.Value>        </Setter>    </Style>    <Style x:Key="WinButton.Close" TargetType="Button" BasedOn="{StaticResource WinButton}">        <Setter Property="Foreground" Value="#F87171" />        <Style.Triggers>            <Trigger Property="IsMouseOver" Value="True">                <Setter Property="Background" Value="#3A1F1F" />                <Setter Property="Foreground" Value="#FFFFFF" />            </Trigger>        </Style.Triggers>    </Style>    <!-- ====================== K╨Э╨Ю╨Я╨Ъ╨Р ╨Э╨Р╨Т╨Ш╨У╨Р╨ж╨Ш╨Ш ╨б╨Р╨Щ╨Ф╨С╨Р╨а╨Р ====================== -->    <Style x:Key="NavButton" TargetType="Button">        <Setter Property="Background" Value="Transparent" />        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />        <Setter Property="BorderThickness" Value="0" />        <Setter Property="Padding" Value="18,10" />        <Setter Property="HorizontalAlignment" Value="Stretch" />        <Setter Property="FontSize" Value="13" />        <Setter Property="Cursor" Value="Hand" />        <Setter Property="Template">            <Setter.Value>                <ControlTemplate TargetType="Button">                    <Border x:Name="Root" Background="{TemplateBinding Background}"                            Padding="{TemplateBinding Padding}">                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />                    </Border>                    <ControlTemplate.Triggers>                        <Trigger Property="IsMouseOver" Value="True">                            <Setter TargetName="Root" Property="Background" Value="#1A1F26" />                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />                        </Trigger>                        <Trigger Property="IsPressed" Value="True">                            <Setter TargetName="Root" Property="Background" Value="#2A313C" />                        </Trigger>                    </ControlTemplate.Triggers>                </ControlTemplate>            </Setter.Value>        </Setter>    </Style>    <!-- ====================== PILL ╨б╨Х╨У╨Ь╨Х╨Э╨в (╨▓╨║╨╗╤О╤З╤С╨╜╨╜╤Л╨╣) ====================== -->    <Style x:Key="PillSegment" TargetType="RadioButton">        <Setter Property="Background" Value="{StaticResource PillActiveBrush}" />        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />        <Setter Property="BorderThickness" Value="0" />        <Setter Property="Padding" Value="10,5" />        <Setter Property="FontSize" Value="12" />        <Setter Property="FontWeight" Value="Medium" />        <Setter Property="Cursor" Value="Hand" />        <Setter Property="Template">            <Setter.Value>                <ControlTemplate TargetType="RadioButton">                    <Border x:Name="Root" Background="{TemplateBinding Background}"                            CornerRadius="6" Padding="{TemplateBinding Padding}">                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />                    </Border>                    <ControlTemplate.Triggers>                        <Trigger Property="IsMouseOver" Value="True">                            <Setter TargetName="Root" Property="Background" Value="{StaticResource PillHoverBrush}" />                        </Trigger>                        <Trigger Property="IsChecked" Value="True">                            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentGradientBrush}" />                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />                        </Trigger>                    </ControlTemplate.Triggers>                </ControlTemplate>            </Setter.Value>        </Setter>    </Style>    <!-- ====================== PILL ╨в╨г╨Ь╨С╨Ы╨Х╨а (switch) ====================== -->    <Style x:Key="PillToggle" TargetType="CheckBox">        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />        <Setter Property="FontSize" Value="13" />        <Setter Property="Cursor" Value="Hand" />        <Setter Property="Template">            <Setter.Value>                <ControlTemplate TargetType="CheckBox">                    <Grid>                        <Grid.ColumnDefinitions>                            <ColumnDefinition Width="Auto" />                            <ColumnDefinition Width="Auto" />                        </Grid.ColumnDefinitions>                        <Border x:Name="Track" Grid.Column="0" Width="46" Height="24"                                Background="#1A1F26" CornerRadius="12" Margin="0,0,10,0" />                        <Border x:Name="Thumb" Grid.Column="0" Width="20" Height="20"                                Background="#94A3B8" CornerRadius="10" Margin="2,2,0,0" />                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />                    </Grid>                    <ControlTemplate.Triggers>                        <Trigger Property="IsChecked" Value="True">                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentGradientBrush}" />                            <Setter TargetName="Thumb" Property="Background" Value="{StaticResource TextPrimaryBrush}" />                            <Setter TargetName="Thumb" Property="Margin" Value="24,2,0,0" />                        </Trigger>                        <Trigger Property="IsMouseOver" Value="True">                            <Setter TargetName="Track" Property="Background" Value="#2A313C" />                        </Trigger>                    </ControlTemplate.Triggers>                </ControlTemplate>            </Setter.Value>        </Setter>    </Style>    <!-- ====================== ╨з╨Х╨Ъ╨С╨Ю╨Ъ╨б (╤В╤Г╨╝╨▒╨╗╨╡╤А ╨╝╨╕╨╜╨╕) ====================== -->    <Style x:Key="MiniToggle" TargetType="CheckBox">        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />        <Setter Property="Template">            <Setter.Value>                <ControlTemplate TargetType="CheckBox">                    <Grid>                        <Border x:Name="Track" Width="40" Height="20" Background="#1A1F26"                                CornerRadius="10" Margin="0,0,8,0" />                        <Border x:Name="Thumb" Width="16" Height="16" Background="#94A3B8"                                CornerRadius="8" Margin="2,2,0,0" />                        <ContentPresenter VerticalAlignment="Center" Margin="48,0,0,0" />                    </Grid>                    <ControlTemplate.Triggers>                        <Trigger Property="IsChecked" Value="True">                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentGradientBrush}" />                            <Setter TargetName="Thumb" Property="Background" Value="{StaticResource TextPrimaryBrush}" />                            <Setter TargetName="Thumb" Property="Margin" Value="22,2,0,0" />                        </Trigger>                    </ControlTemplate.Triggers>                </ControlTemplate>            </Setter.Value>        </Setter>    </Style>    <!-- ====================== ╨Я╨а╨Ю╨У╨а╨Х╨б╨б-╨С╨Р╨а ====================== -->    <Style x:Key="GlassProgressBar" TargetType="ProgressBar">        <Setter Property="Background" Value="#1A1F26" />        <Setter Property="Foreground" Value="{StaticResource AccentGradientBrush}" />        <Setter Property="BorderThickness" Value="0" />        <Setter Property="Height" Value="6" />        <Setter Property="Maximum" Value="100" />    </Style>    <!-- ====================== ╨Ш╨Э╨Я╨г╨в (╤В╨╡╨║╤Б╤В╨╛╨▓╨╛╨╡ ╨┐╨╛╨╗╨╡) ====================== -->    <Style x:Key="GlassTextBox" TargetType="TextBox">        <Setter Property="Background" Value="#1A1F26" />        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />        <Setter Property="BorderBrush" Value="#2A313C" />        <Setter Property="BorderThickness" Value="1" />        <Setter Property="Padding" Value="10,8" />        <Setter Property="Template">            <Setter.Value>                <ControlTemplate TargetType="TextBox">                    <Border x:Name="Root" Background="{TemplateBinding Background}"                            BorderBrush="{TemplateBinding BorderBrush}"                            BorderThickness="{TemplateBinding BorderThickness}"                            CornerRadius="8" Padding="{TemplateBinding Padding}">                        <ScrollViewer x:Name="PART_Content" />                    </Border>                    <ControlTemplate.Triggers>                        <Trigger Property="IsFocused" Value="True">                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentEnd}" />                        </Trigger>                    </ControlTemplate.Triggers>                </ControlTemplate>            </Setter.Value>        </Setter>    </Style>    <!-- ====================== ╨б╨Ъ╨а╨Ю╨Ы╨Ы╨С╨Р╨а (╤Г╨╖╨║╨╕╨╣, ╤В╤С╨╝╨╜╤Л╨╣) ====================== -->    <Style TargetType="ScrollBar">        <Setter Property="Width" Value="8" />        <Setter Property="Background" Value="Transparent" />        <Setter Property="Template">            <Setter.Value>                <ControlTemplate TargetType="ScrollBar">                    <Grid Background="Transparent">                        <Track x:Name="PART_Track" IsDirectionReversed="True">                            <Track.Thumb>                                <Thumb Background="#2A313C" />                            </Track.Thumb>                        </Track>                    </Grid>                </ControlTemplate>            </Setter.Value>        </Setter>    </Style>    <!-- ================= LISTBOX (╤В╤С╨╝╨╜╤Л╨╣) ================= -->    <Style TargetType="ListBox">        <Setter Property="Background" Value="#1A1F26" />        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />        <Setter Property="BorderBrush" Value="#2A313C" />        <Setter Property="BorderThickness" Value="1" />        <Setter Property="Padding" Value="4" />    </Style>    <Style TargetType="ListBoxItem">        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />        <Setter Property="Padding" Value="6,4" />        <Style.Triggers>            <Trigger Property="IsMouseOver" Value="True">                <Setter Property="Background" Value="#2A313C" />            </Trigger>            <Trigger Property="IsSelected" Value="True">                <Setter Property="Background" Value="#3A4150" />            </Trigger>        </Style.Triggers>    </Style></ResourceDictionary>